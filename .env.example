# ---------------------------------------------------------------------------
# LeadPilot — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (Neon, free tier) --------------------------------------------
# Neon → your project → Connection string.
# DATABASE_URL must be the POOLED connection (host contains "-pooler"), which is
# what serverless functions should use.
# DIRECT_URL must be the UNPOOLED connection — Prisma migrations require it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# `neon link` writes this name for the unpooled endpoint. DIRECT_URL wins if both
# are set; this is accepted as a fallback so a fresh `neon link` just works.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate a fresh value for each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use DIFFERENT values for the two secrets, and different values per environment.
JWT_ACCESS_SECRET="replace-me-with-48-random-bytes"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-random-bytes"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to false only for local HTTP development; must be true in production.
COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to send credentialed requests.
# In development, loopback (localhost / 127.0.0.1) and private-LAN addresses are
# accepted on ANY port regardless of this list, so a Vite port bump or testing on
# your phone does not need a config change.
# In production this list is the only thing accepted — but on Vercel the client
# is same-origin, so it can stay empty there.
CORS_ORIGINS=http://localhost:5173

# --- Errors -----------------------------------------------------------------
# Return the real error message and stack to the client in production too.
# Development always does this. Leave unset on anything public: it is
# information disclosure. Handy on a portfolio demo you alone are debugging.
# EXPOSE_ERROR_DETAILS=false

# --- Client -----------------------------------------------------------------
# Where the Vite dev server proxies /api. Leave unset to use http://localhost:4000.
# VITE_DEV_API_URL=http://localhost:4000
