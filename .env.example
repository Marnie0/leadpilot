# ---------------------------------------------------------------------------
# LeadPilot — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (Neon, free tier) --------------------------------------------
# Neon → your project → Connection string.
# DATABASE_URL must be the POOLED connection (host contains "-pooler"), which is
# what serverless functions should use.
# DIRECT_URL must be the UNPOOLED connection — Prisma migrations require it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# `neon link` writes this name for the unpooled endpoint. DIRECT_URL wins if both
# are set; this is accepted as a fallback so a fresh `neon link` just works.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate a fresh value for each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use DIFFERENT values for the two secrets, and different values per environment.
JWT_ACCESS_SECRET="replace-me-with-48-random-bytes"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-random-bytes"

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to false only for local HTTP development; must be true in production.
COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to send credentialed requests.
# In development, loopback (localhost / 127.0.0.1) and private-LAN addresses are
# accepted on ANY port regardless of this list, so a Vite port bump or testing on
# your phone does not need a config change.
# In production this list is the only thing accepted — but on Vercel the client
# is same-origin, so it can stay empty there.
CORS_ORIGINS=http://localhost:5173

# --- Demo sandbox cleanup ---------------------------------------------------
# Bearer token the daily Vercel cron presents to /api/internal/reap-demo-sandboxes.
# Leave unset locally: the endpoint stays CLOSED without it, never open.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CRON_SECRET=

# --- Errors -----------------------------------------------------------------
# Return the real error message and stack to the client in production too.
# Development always does this. Leave unset on anything public: it is
# information disclosure. Handy on a portfolio demo you alone are debugging.
# EXPOSE_ERROR_DETAILS=false

# --- Client -----------------------------------------------------------------
# Where the Vite dev server proxies /api. Leave unset to use http://localhost:4000.
# VITE_DEV_API_URL=http://localhost:4000

# --- AI lead assistant (optional) -------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey — no credit card.
# Leave unset and the assistant renders a "not set up" state; everything else
# works unchanged. Do NOT enable billing on the Google Cloud project behind the
# key: that removes the free tier from it and every call becomes chargeable.
#
# Note: Gemini's free tier uses what it receives to improve Google's products,
# which is why the assistant is off per workspace until an owner turns it on.
GEMINI_API_KEY=
# Pinned rather than tracking an alias, so a provider-side default moving cannot
# change what the product says about somebody's leads.
AI_MODEL=gemini-3.5-flash-lite
# Analyses one workspace may run per rolling 24 hours.
AI_DAILY_LIMIT_PER_ORG=25
# The same, for a throwaway demo sandbox. Much smaller: every visitor gets their
# own workspace and all of them draw on one free-tier key.
AI_DEMO_DAILY_LIMIT=5

# --- Team invitations and email -------------------------------------------
# New workspaces one IP may create per hour, and invitations it may accept.
# Accepting has its own, larger budget: it needs a single-use token an admin
# issued, and a company onboarding from one office IP is a single address.
SIGNUP_RATE_LIMIT=5
INVITE_RATE_LIMIT=30
# Resend key for verification, invite and reset email. Without it nothing is
# sent and the message is logged instead — every flow still works.
RESEND_API_KEY=
# onboarding@resend.dev needs no DNS but delivers ONLY to the address on your
# own Resend account. Point this at a verified domain to reach anyone.
EMAIL_FROM=LeadPilot <onboarding@resend.dev>
# Public origin used to build the links inside emails. Never derived from the
# request Host header, which an attacker controls.
APP_URL=http://localhost:5173
# Invitations one workspace may create per hour, counted in the database so
# the cap holds across serverless instances.
INVITE_WORKSPACE_HOURLY_LIMIT=20

# --- Operations ------------------------------------------------------------
# Bearer secret for the daily cron (expired demo sandboxes, trash older than
# 30 days). The endpoint is closed while this is unset.
CRON_SECRET=
# Include the real error name, message and stack in API error bodies even in
# production. Off by default there; useful on a demo only you are debugging.
EXPOSE_ERROR_DETAILS=false
