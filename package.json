{
  "name": "leadpilot",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "LeadPilot — bilingual lead management for small and medium service businesses",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @leadpilot/server",
    "dev:client": "npm run dev --workspace @leadpilot/client",
    "build": "npm run build --workspace @leadpilot/server && npm run build --workspace @leadpilot/client",
    "build:vercel": "prisma generate --schema server/prisma/schema.prisma && prisma migrate deploy --schema server/prisma/schema.prisma && npm run build --workspace @leadpilot/server && npm run build --workspace @leadpilot/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @leadpilot/server",
    "db:push": "npm run db:push --workspace @leadpilot/server",
    "db:migrate": "npm run db:migrate --workspace @leadpilot/server",
    "db:seed": "npm run db:seed --workspace @leadpilot/server",
    "db:seed:isolation": "npm run db:seed:isolation --workspace @leadpilot/server",
    "db:reset": "npm run db:reset --workspace @leadpilot/server",
    "db:studio": "npm run db:studio --workspace @leadpilot/server",
    "db:deploy": "npm run db:deploy --workspace @leadpilot/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.70.0"
  }
}
