// LeadPilot data model
//
// Multi-tenancy: every tenant-owned row carries `organizationId`. The API layer
// (server/src/middleware/auth.ts + the module services) scopes *every* query by
// the caller's organization, and the compound indexes below are ordered
// organisation-first so those scoped queries stay index-covered.

generator client {
  provider = "prisma-client-js"
  // "native" covers local development; the rhel target is what Vercel's
  // Node runtime (Amazon Linux 2023) loads at request time.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon PgBouncer) used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — required for migrations and introspection.
  directUrl = env("DIRECT_URL")
}

/* ------------------------------------------------------------------ *
 * Enums — these mirror shared/src/enums.ts exactly.
 * ------------------------------------------------------------------ */

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum Locale {
  en
  ar
}

enum StageKey {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum StageType {
  OPEN
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PAID_ADS
  COLD_CALL
  EMAIL_CAMPAIGN
  EVENT
  WALK_IN
  PARTNER
  MARKETPLACE
  OTHER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
  LEAD_CREATED
  STAGE_CHANGED
  ASSIGNED
  FIELD_UPDATED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
}

enum FollowUpChannel {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  SMS
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/* ------------------------------------------------------------------ *
 * Tenancy
 * ------------------------------------------------------------------ */

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Fallback currency for new leads; each lead may override it.
  defaultCurrency String   @default("USD")
  defaultLocale   Locale   @default(en)
  /// A throwaway sandbox created by "Start demo". Cloned from the template.
  isDemo          Boolean  @default(false)
  /// The pristine workspace every demo sandbox is cloned from. Nobody signs into
  /// it directly, so visitor edits can never reach it.
  isDemoTemplate  Boolean  @default(false)
  /// When a demo sandbox is reaped. Null for real workspaces and for the template.
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users      User[]
  stages     PipelineStage[]
  leads      Lead[]
  activities Activity[]
  followUps  FollowUp[]

  // Drives the daily reaper, which scans for sandboxes past their expiry.
  @@index([expiresAt])
  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  /// scrypt digest — never leaves the service layer. See server/src/lib/password.ts.
  passwordHash   String
  name           String
  role           UserRole @default(MEMBER)
  locale         Locale   @default(en)
  /// What currency this person reads figures in. Null follows the workspace.
  /// Display only — no stored amount is ever quoted in it.
  displayCurrency String?
  /// Tailwind-friendly hex used for the avatar fallback, assigned at signup.
  avatarColor    String   @default("#2563eb")
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  createdLeads  Lead[]         @relation("LeadCreator")
  activities    Activity[]
  followUps     FollowUp[]     @relation("FollowUpAssignee")
  createdFollowUps FollowUp[]  @relation("FollowUpCreator")

  @@index([organizationId, isActive])
  @@map("users")
}

/// One row per issued refresh token, so a session can be revoked server-side.
/// Rotation: using a token revokes it and links the replacement via `replacedById`.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the raw token. The raw value only ever exists in the cookie.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

/// Daily FX reference rates, cached so the app is not making a third-party
/// call on the render path — and so it keeps working when that third party is
/// down. One row per quote currency, all against a single pivot (`base`), which
/// is what stops `USD→AED` and `AED→USD` drifting out of being each other's
/// reciprocal. Not tenant-scoped: an exchange rate is not anybody's data.
model ExchangeRate {
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  /// The day these rates are quoted for, as published upstream.
  asOf      DateTime @db.Date
  fetchedAt DateTime @default(now())

  @@id([base, quote])
  @@map("exchange_rates")
}

/* ------------------------------------------------------------------ *
 * Pipeline
 * ------------------------------------------------------------------ */

/// Stages are rows rather than a bare enum so each tenant can rename, recolour
/// and reorder its board (Phase 2) and carry an Arabic label (Phase 3) without
/// a migration. `key` keeps the six canonical stages addressable in code.
model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  key            StageKey
  name           String
  nameAr         String
  /// Hex colour used for the stage badge and board column header.
  color          String
  order          Int
  type           StageType @default(OPEN)
  /// Percentage of leads in this stage that are expected to close (0-100).
  /// Drives the dashboard's weighted revenue forecast. Stored per tenant rather
  /// than hard-coded in the UI so a workspace can tune it against its own
  /// history — which is what makes the forecast a real number and not a guess
  /// baked into a chart component.
  winProbability Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@unique([organizationId, order])
  @@index([organizationId, order])
  @@map("pipeline_stages")
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  customerName   String
  company        String?
  email          String?
  phone          String?
  source         LeadSource   @default(OTHER)
  requestedService String
  estimatedValue Decimal      @default(0) @db.Decimal(14, 2)
  currency       String       @default("USD")
  priority       LeadPriority @default(MEDIUM)
  description    String?
  tags           String[]     @default([])

  stageId        String
  assignedToId   String?
  createdById    String?

  /// Rank within the stage column — reserved for Phase 2 drag-and-drop ordering.
  boardPosition  Int          @default(0)

  /// Denormalised from the earliest PENDING FollowUp so the table can sort and
  /// filter on it without a correlated subquery. Maintained in follow-up.service.
  nextFollowUpAt DateTime?
  /// Denormalised from the newest Activity, for the "last touched" column.
  lastActivityAt DateTime?
  lastContactedAt DateTime?

  lostReason     String?
  wonAt          DateTime?
  lostAt         DateTime?

  /// Soft delete. Archiving hides a lead from every list and aggregate while
  /// preserving its activity trail and follow-ups, which a cascading hard delete
  /// destroyed irrecoverably. Restorable by an owner or admin.
  archivedAt     DateTime?
  archivedById   String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  assignedTo   User?         @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities   Activity[]
  followUps    FollowUp[]

  // Ordered organisation-first: every list query is tenant-scoped, then sorted.
  // archivedAt leads each index because every list filters archived rows out.
  @@index([organizationId, archivedAt, updatedAt(sort: Desc)])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, stageId, boardPosition])
  @@index([organizationId, assignedToId])
  @@index([organizationId, nextFollowUpAt])
  @@map("leads")
}

/* ------------------------------------------------------------------ *
 * Activity & follow-ups
 * ------------------------------------------------------------------ */

/// Append-only timeline. User-authored entries carry `body`; system entries
/// carry structured `metadata` so the UI can render them in either language.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           ActivityType @default(NOTE)
  body           String?
  metadata       Json?
  /// When the thing happened (a rep can back-date a logged call).
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("activities")
}

model FollowUp {
  id             String          @id @default(cuid())
  organizationId String
  leadId         String
  assignedToId   String?
  createdById    String?
  title          String
  notes          String?
  dueAt          DateTime
  channel        FollowUpChannel @default(CALL)
  status         FollowUpStatus  @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([leadId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@map("follow_ups")
}
