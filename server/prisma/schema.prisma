// LeadPilot data model
//
// Multi-tenancy: every tenant-owned row carries `organizationId`. The API layer
// (server/src/middleware/auth.ts + the module services) scopes *every* query by
// the caller's organization, and the compound indexes below are ordered
// organisation-first so those scoped queries stay index-covered.

generator client {
  provider = "prisma-client-js"
  // "native" covers local development; the rhel target is what Vercel's
  // Node runtime (Amazon Linux 2023) loads at request time.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon PgBouncer) used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — required for migrations and introspection.
  directUrl = env("DIRECT_URL")
}

/* ------------------------------------------------------------------ *
 * Enums — these mirror shared/src/enums.ts exactly.
 * ------------------------------------------------------------------ */

/// The three roles every workspace starts with. Custom roles have no key.
///
/// Kept as an enum rather than a plain string so the seeded roles stay
/// addressable in code — "the member role of this workspace" has to be
/// findable to assign an invitee, whatever the owner has renamed it to.
enum RoleKey {
  OWNER
  ADMIN
  MEMBER
}

/// What a role is allowed to do.
///
/// Deliberately a short, closed list of things this product actually gates,
/// rather than a generic resource×verb matrix. Every entry here corresponds to
/// a guard that already existed as `isManager` or `requireRole`; making them
/// nameable is what turns "admin" from a hard-coded tier into a description of
/// a permission set somebody chose.
///
/// Three powers are deliberately absent, because they belong to the owner alone
/// and are not delegable: managing roles, transferring ownership, and deleting
/// the workspace. A permission you can grant yourself is not a permission —
/// anyone who could edit roles could hand themselves everything else.
enum Permission {
  /// Invite people, change their role, remove them.
  MANAGE_TEAM
  /// Rename the workspace, change its default language.
  MANAGE_WORKSPACE
  /// Restate every stored amount into another currency. Irreversible.
  CHANGE_CURRENCY
  /// Edit any lead, not only the ones assigned to or created by you.
  EDIT_ALL_LEADS
  /// Archive, trash, restore and permanently delete leads.
  DELETE_LEADS
  /// Turn the AI assistant on or off for the workspace.
  MANAGE_AI
}

enum Locale {
  en
  ar
}

enum StageKey {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum StageType {
  OPEN
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  PAID_ADS
  COLD_CALL
  EMAIL_CAMPAIGN
  EVENT
  WALK_IN
  PARTNER
  MARKETPLACE
  OTHER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
  LEAD_CREATED
  STAGE_CHANGED
  ASSIGNED
  FIELD_UPDATED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
}

enum FollowUpChannel {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  SMS
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// How soon an analysed lead needs a human. Mirrors AI_URGENCIES.
enum AiUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Workspace-level events, distinct from a lead's activity trail.
/// Currently one member; the enum exists so adding the next is a migration
/// rather than a redesign.
enum WorkspaceEventType {
  CURRENCY_CHANGED
  OWNERSHIP_TRANSFERRED
  MEMBER_INVITED
  INVITE_ACCEPTED
  INVITE_REVOKED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ACCOUNT_DELETED
}

/// What a one-time emailed token is for.
///
/// One table rather than two, because verification and reset are the same
/// mechanism — a hashed secret with an expiry that can be spent once — and two
/// implementations of that would eventually disagree about the interesting
/// parts, which are the expiry and the single-use guarantee.
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/* ------------------------------------------------------------------ *
 * Tenancy
 * ------------------------------------------------------------------ */

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Fallback currency for new leads; each lead may override it.
  defaultCurrency String   @default("USD")
  defaultLocale   Locale   @default(en)
  /// Whether the AI lead assistant is switched on for this workspace.
  ///
  /// Off by default, and only an owner can turn it on. The assistant sends lead
  /// text to a third party whose free tier trains on what it receives, so
  /// enabling it is a decision about somebody's customer data — not a default
  /// the product gets to make on their behalf.
  aiEnabled       Boolean  @default(false)
  /// A throwaway sandbox created by "Start demo". Cloned from the template.
  isDemo          Boolean  @default(false)
  /// The pristine workspace every demo sandbox is cloned from. Nobody signs into
  /// it directly, so visitor edits can never reach it.
  isDemoTemplate  Boolean  @default(false)
  /// When a demo sandbox is reaped. Null for real workspaces and for the template.
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users      User[]
  roles      Role[]
  stages     PipelineStage[]
  leads      Lead[]
  activities Activity[]
  followUps  FollowUp[]
  events      WorkspaceEvent[]
  invitations Invitation[]
  insights   LeadInsight[]
  aiUsage    AiUsageEvent[]
  summary    WorkspaceSummary?

  // Drives the daily reaper, which scans for sandboxes past their expiry.
  @@index([expiresAt])
  @@map("organizations")
}

/// A named set of permissions, per workspace.
///
/// Every workspace is seeded with three — owner, admin, member — reproducing
/// exactly the behaviour that used to be hard-coded in `isManager` and
/// `requireRole`. The owner may add more, rename any of them in both languages,
/// and change what the non-owner ones can do.
///
/// The owner role is not editable: its permission set is "everything", and a
/// workspace whose owner could remove their own ability to manage the team is a
/// workspace nobody can administer.
model Role {
  id             String       @id @default(cuid())
  organizationId String
  /// Set for the three seeded roles, null for anything the owner creates.
  key            RoleKey?
  name           String
  /// Arabic label, so a renamed role reads correctly in both languages —
  /// the same reasoning as `PipelineStage.nameAr`.
  nameAr         String
  permissions    Permission[] @default([])
  /// True for the seeded three. They may be renamed but never deleted:
  /// something has to be assignable, and the owner role has to exist.
  isSystem       Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId, order])
  @@map("roles")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  /// scrypt digest — never leaves the service layer. See server/src/lib/password.ts.
  passwordHash   String
  name           String
  /// The role this account holds. Carries the permissions.
  roleId         String
  /**
   * Whether this account owns the workspace.
   *
   * Separate from the role because ownership is not a permission set: it is
   * the answer to "whose workspace is this", it is unique, and it cannot be
   * granted by editing a role. Keeping it as its own column is what lets the
   * database enforce exactly one owner — see the partial unique index — which a
   * role membership could not.
   */
  isOwner        Boolean  @default(false)
  locale         Locale   @default(en)
  /// What currency this person reads figures in. Null follows the workspace.
  /// Display only — no stored amount is ever quoted in it.
  displayCurrency String?
  /// Tailwind-friendly hex used for the avatar fallback, assigned at signup.
  avatarColor    String   @default("#2563eb")
  isActive       Boolean  @default(true)
  /// When this address was confirmed by clicking an emailed link.
  ///
  /// Null means unconfirmed, which is *not* a restriction: an unverified user
  /// signs in and works normally, and sees a banner offering to resend. Gating
  /// the product on delivery would mean a mail outage locks people out of
  /// their own workspace, which is a worse failure than an unconfirmed address.
  emailVerifiedAt DateTime?
  /// Access tokens issued before this instant are rejected.
  ///
  /// Revoking refresh tokens is not enough on its own: an access token is a
  /// stateless JWT that stays valid until it expires, so a password reset left
  /// whoever held one with up to fifteen more minutes of access — which is
  /// precisely the window the reset was meant to close. `requireAuth` compares
  /// the token's `iat` against this, so a credential change takes effect on the
  /// very next request.
  sessionsValidFrom DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  assignedLeads Lead[]         @relation("LeadAssignee")
  createdLeads  Lead[]         @relation("LeadCreator")
  activities    Activity[]
  followUps     FollowUp[]     @relation("FollowUpAssignee")
  createdFollowUps FollowUp[]  @relation("FollowUpCreator")
  workspaceEvents  WorkspaceEvent[]
  authTokens       AuthToken[]
  sentInvitations  Invitation[]  @relation("InvitationCreator")
  acceptedInvitation Invitation?  @relation("InvitationAcceptor")
  generatedInsights LeadInsight[]
  generatedSummaries WorkspaceSummary[]

  @@index([organizationId, isActive])
  @@map("users")
}

/// One row per issued refresh token, so a session can be revoked server-side.
/// Rotation: using a token revokes it and links the replacement via `replacedById`.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the raw token. The raw value only ever exists in the cookie.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

/// A one-time secret emailed to somebody, for verifying an address or resetting
/// a password.
///
/// Only the SHA-256 of the token is stored: the raw value exists in the email
/// and nowhere else, so a database read cannot be turned into an account
/// takeover. `usedAt` makes it single-use — a reset link forwarded, logged by a
/// mail scanner or sitting in a browser history is spent the moment it works
/// once.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  /// SHA-256 of the raw token. Unique so a collision is a write error, not a
  /// silent cross-account match.
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Drives "invalidate this user's other tokens of the same kind" on issue.
  @@index([userId, type])
  // Drives the housekeeping sweep for expired rows.
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// An invitation to join a workspace, addressed by a link.
///
/// Single-use and expiring on purpose. A permanent reusable join link is a
/// credential that outlives the conversation it was pasted into — it sits in
/// chat history and inboxes forever, and nothing about it says who used it.
/// This one names the role it grants, records who issued it, and stops working
/// the moment somebody accepts.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  /// Optional. When set, only this address may accept — which is what makes an
  /// invite forwarded to the wrong person fail closed rather than silently
  /// admitting a stranger.
  email          String?
  /// The role the invitee lands on.
  ///
  /// Issuing an invitation grants a role, so it is bounded by the same rule as
  /// granting one directly: you cannot invite somebody into a role holding
  /// permissions you do not hold yourself.
  roleId         String
  /// SHA-256 of the raw token, exactly as `AuthToken`.
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?   @unique
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User?        @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("invitations")
}

/// Daily FX reference rates, cached so the app is not making a third-party
/// call on the render path — and so it keeps working when that third party is
/// down. One row per quote currency, all against a single pivot (`base`), which
/// is what stops `USD→AED` and `AED→USD` drifting out of being each other's
/// reciprocal. Not tenant-scoped: an exchange rate is not anybody's data.
model ExchangeRate {
  base      String
  quote     String
  rate      Decimal  @db.Decimal(18, 8)
  /// The day these rates are quoted for, as published upstream.
  asOf      DateTime @db.Date
  fetchedAt DateTime @default(now())

  @@id([base, quote])
  @@map("exchange_rates")
}

/* ------------------------------------------------------------------ *
 * Pipeline
 * ------------------------------------------------------------------ */

/// Stages are rows rather than a bare enum so each tenant can rename, recolour
/// and reorder its board (Phase 2) and carry an Arabic label (Phase 3) without
/// a migration. `key` keeps the six canonical stages addressable in code.
model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  key            StageKey
  name           String
  nameAr         String
  /// Hex colour used for the stage badge and board column header.
  color          String
  order          Int
  type           StageType @default(OPEN)
  /// Percentage of leads in this stage that are expected to close (0-100).
  /// Drives the dashboard's weighted revenue forecast. Stored per tenant rather
  /// than hard-coded in the UI so a workspace can tune it against its own
  /// history — which is what makes the forecast a real number and not a guess
  /// baked into a chart component.
  winProbability Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, key])
  @@unique([organizationId, order])
  @@index([organizationId, order])
  @@map("pipeline_stages")
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  customerName   String
  company        String?
  email          String?
  phone          String?
  source         LeadSource   @default(OTHER)
  requestedService String
  estimatedValue Decimal      @default(0) @db.Decimal(14, 2)
  currency       String       @default("USD")
  priority       LeadPriority @default(MEDIUM)
  description    String?
  tags           String[]     @default([])

  stageId        String
  assignedToId   String?
  createdById    String?

  /// Rank within the stage column — reserved for Phase 2 drag-and-drop ordering.
  boardPosition  Int          @default(0)

  /// Denormalised from the earliest PENDING FollowUp so the table can sort and
  /// filter on it without a correlated subquery. Maintained in follow-up.service.
  nextFollowUpAt DateTime?
  /// Denormalised from the newest Activity, for the "last touched" column.
  lastActivityAt DateTime?
  lastContactedAt DateTime?

  lostReason     String?
  wonAt          DateTime?
  lostAt         DateTime?

  /// Filing, not removal. Archiving hides a lead from every list and aggregate
  /// while preserving its activity trail and follow-ups forever. Restorable by
  /// an owner or admin, and never purged — keeping the history is the point.
  archivedAt     DateTime?
  archivedById   String?

  /// Trash. A different intention from archiving: this record should not exist.
  /// It leaves every view immediately, stays restorable to whatever state it
  /// was in — archived leads come back archived — and the daily reaper destroys
  /// it, along with its activities and follow-ups, after TRASH_RETENTION_DAYS.
  deletedAt      DateTime?
  deletedById    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  assignedTo   User?         @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activities   Activity[]
  followUps    FollowUp[]
  insight      LeadInsight?

  // Ordered organisation-first: every list query is tenant-scoped, then sorted.
  // archivedAt leads each index because every list filters archived rows out.
  @@index([organizationId, deletedAt, archivedAt, updatedAt(sort: Desc)])
  @@index([organizationId, updatedAt(sort: Desc)])
  // Drives the purge, which scans for leads trashed long enough ago.
  @@index([deletedAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, stageId, boardPosition])
  @@index([organizationId, assignedToId])
  @@index([organizationId, nextFollowUpAt])
  @@map("leads")
}

/* ------------------------------------------------------------------ *
 * Activity & follow-ups
 * ------------------------------------------------------------------ */

/// Append-only timeline. User-authored entries carry `body`; system entries
/// carry structured `metadata` so the UI can render them in either language.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           ActivityType @default(NOTE)
  body           String?
  metadata       Json?
  /// When the thing happened (a rep can back-date a logged call).
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@map("activities")
}

/// Records something that happened to the workspace itself rather than to one
/// lead — which is why it cannot live in `Activity`, whose every row needs a
/// `leadId`. Written for changes that are consequential and irreversible, so
/// that "who converted our currency, and when" has an answer.
model WorkspaceEvent {
  id             String             @id @default(cuid())
  organizationId String
  /// Null once the person who did it has been removed from the workspace.
  userId         String?
  type           WorkspaceEventType
  /// Shape depends on `type`; for CURRENCY_CHANGED: from, to, rate, leads.
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("workspace_events")
}

/// One AI assessment of one lead.
///
/// `@unique` on `leadId` rather than a history table: the assistant answers a
/// question ("what should we do about this lead"), and only the current answer
/// is actionable. A regeneration replaces the previous one, and the row carries
/// who asked for it and when, which is the audit that actually gets read.
model LeadInsight {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String   @unique
  /// Language the prose was written in, so the reader can be told when the
  /// stored analysis is not in the language they are reading the app in.
  locale         Locale   @default(en)

  summary        String
  /// 0-100. The band is derived, not stored — see `qualityBand()`.
  qualityScore   Int
  urgency        AiUrgency
  rationale      String
  nextAction     String
  nextActionChannel FollowUpChannel @default(CALL)
  draftMessage   String
  signals        String[] @default([])

  /// Provider model id, recorded so an assessment can be attributed to the
  /// thing that made it once the default has moved on.
  model          String
  /// Fingerprint of the lead fields fed to the model. Compared on read to tell
  /// the user their analysis predates the lead's current state.
  inputHash      String
  generatedById  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  // Drives the per-workspace daily budget, which counts rows written since a
  // cutoff. Organisation-first so that count stays index-covered.
  @@index([organizationId, updatedAt])
  @@map("lead_insights")
}

/// One row per provider call that actually happened.
///
/// Deliberately not derived from `LeadInsight`. The two answer different
/// questions: a `LeadInsight` is the *current* analysis of a lead and vanishes
/// when somebody discards it or deletes the lead, whereas this is what the
/// workspace **spent**, which nothing a user does should be able to give back.
/// Counting the daily budget off `LeadInsight` meant generate-then-discard
/// refunded the quota, which is exactly the loop the budget exists to stop.
///
/// No relation to `Lead` for the same reason: deleting a lead must not erase
/// the record of the call it cost. `leadId` is kept as a plain column so a run
/// can still be traced back.
model AiUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  leadId         String?
  model          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Covers the budget count, which is always "this org, since this instant".
  @@index([organizationId, createdAt])
  // Drives the housekeeping sweep, which drops rows past the counting window.
  @@index([createdAt])
  @@map("ai_usage_events")
}

/// The assistant's read of a whole workspace, rather than of one lead.
///
/// One row per organisation, replaced on each run — same reasoning as
/// `LeadInsight`: the question is "what should we do about this pipeline", and
/// only the current answer is actionable. It is stored for the same three
/// reasons too: it is a shared artefact a team should be reading one copy of,
/// reading it costs nothing so a visitor cannot spend quota by clicking, and
/// `generatedAt` plus `model` make an assessment attributable.
model WorkspaceSummary {
  id             String   @id @default(cuid())
  organizationId String   @unique
  locale         Locale   @default(en)

  /// Two or three sentences: the state of the pipeline as a whole.
  headline       String
  /// Ordered, most pressing first. Shape: { title, detail, severity }.
  attention      Json
  /// What is moving, and in which direction. Shape: { title, detail }.
  trends         Json
  /// One thing to do today, phrased as an instruction.
  nextStep       String

  model          String
  /// Fingerprint of the figures the summary was written from, so a workspace
  /// that has moved on since can be told its summary predates the change.
  inputHash      String
  generatedById  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedBy  User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@map("workspace_summaries")
}

model FollowUp {
  id             String          @id @default(cuid())
  organizationId String
  leadId         String
  assignedToId   String?
  createdById    String?
  title          String
  notes          String?
  dueAt          DateTime
  channel        FollowUpChannel @default(CALL)
  status         FollowUpStatus  @default(PENDING)
  completedAt    DateTime?
  /// Trash, not deletion. A deleted follow-up leaves every view but stays
  /// restorable until the daily reaper purges it — see TRASH_RETENTION_DAYS.
  /// Deliberately *not* the same idea as `Lead.archivedAt`: archiving a lead is
  /// filing something you want to keep, and is never purged.
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // `deletedAt` leads the list indexes because every view filters the trash out.
  @@index([organizationId, deletedAt, status, dueAt])
  @@index([leadId, deletedAt, status, dueAt])
  @@index([assignedToId, deletedAt, status, dueAt])
  // Drives the purge, which scans for rows trashed long enough ago.
  @@index([deletedAt])
  @@map("follow_ups")
}
