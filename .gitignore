# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment — never commit real credentials.
# .env.example is the committed template.
.env
.env.*
!.env.example

# Secrets / keys
*.pem
*.key
*.p12

# Hosting + tooling local state
.vercel/
.neon
.turbo/
.cache/

# Local agent tooling (installed by `neon skills` / `neon mcp`), not project code
.claude/
skills-lock.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma local databases
server/prisma/*.db
server/prisma/*.db-journal

# Test / coverage
coverage/
playwright-report/
test-results/

# ESLint cache, if the flag is ever used.
.eslintcache
